{
  "name": "Release Notes Agent - GitHub Push",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "github-push",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "GitHub Push Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300],
      "webhookId": "github-push"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Extract commits from GitHub push payload\nconst payload = $input.first().json.body ?? $input.first().json;\n\nconst repo = payload.repository?.full_name ?? 'unknown/repo';\nconst before = (payload.before ?? '').substring(0, 7);\nconst after = (payload.after ?? '').substring(0, 7);\nconst ref = payload.ref ?? '';\nconst branch = ref.replace('refs/heads/', '');\n\n// Only process pushes to main/master\nif (branch !== 'main' && branch !== 'master') {\n  return [{ json: { skip: true, reason: `Push to ${branch}, skipping` } }];\n}\n\nconst commits = (payload.commits ?? []).map(c => ({\n  sha: c.id,\n  message: c.message,\n  author: c.author?.name ?? c.author?.username ?? 'unknown',\n  url: c.url\n}));\n\nif (commits.length === 0) {\n  return [{ json: { skip: true, reason: 'No commits in push' } }];\n}\n\nreturn [{\n  json: {\n    skip: false,\n    payload: {\n      version: '0.1',\n      input: {\n        mode: 'fixture',\n        repo: repo,\n        rangeLabel: `${before}..${after}`,\n        commits: commits\n      },\n      dryRun: false\n    }\n  }\n}];"
      },
      "id": "transform-payload",
      "name": "Transform Push to Agent Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [470, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-skip",
              "leftValue": "={{ $json.skip }}",
              "rightValue": false,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-should-run",
      "name": "Should Run?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [690, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://fyrk-agent-runtime.fly.dev/run/release-notes",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.payload) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "call-runtime",
      "name": "Call Release Notes Agent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [910, 200]
    },
    {
