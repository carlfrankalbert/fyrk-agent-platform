# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Claude / Anthropic
ANTHROPIC_API_KEY=your-claude-api-key
OPENAI_API_KEY=your-openai-api-key
CV_SECOND_OPINION_PROVIDER=openai
OPENAI_CV_REVIEW_MODEL=gpt-4o-mini-2024-07-18

# Hub (family dashboard)
HUB_ACCESS_CODE=your-access-code

# Oda (grocery integration)
ODA_EMAIL=your@email.com
ODA_PASSWORD=your-password

# GitHub (n8n releaselog workflow)
GITHUB_TOKEN=your-github-token

# n8n
N8N_USER=admin
N8N_PASSWORD=changeme

# Operator token for internal agents touching private state (character agents). Min 24 chars; `openssl rand -hex 32`
AGENT_OPERATOR_TOKEN=

# Assignment radar (Slack bot needs chat:write and membership in the target channel)
ASSIGNMENT_RADAR_THRESHOLD=70
ASSIGNMENT_RADAR_SLACK_BOT_TOKEN=
ASSIGNMENT_RADAR_SLACK_CHANNEL=

# FYRK Slack bot (POST /slack/fyrk-bot-events). Manifest: docs/slack-bot/slack-app-manifest.yml
SLACK_FYRK_BOT_TOKEN=
SLACK_FYRK_SIGNING_SECRET=
# Module that answers by default, and optional per-channel overrides as JSON, e.g. {"C0123ABC":"handbook"}
SLACK_BOT_DEFAULT_MODULE=handbook
SLACK_BOT_CHANNEL_MODULES=
